# Plant Plotter backend defaults
PORT=5001
NODE_ENV=development

# Comma-separate multiple allowed frontend origins if needed.
FRONTEND_URL=http://localhost:3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=garden_plotter
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=60000

# Local MySQL usually does not need SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=

# Production Aiven MySQL must use verified TLS:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem

# Authentication
# NODE_ENV=production enables the Secure, host-only production auth cookie.
JWT_SECRET=replace_with_a_local_development_secret
JWT_EXPIRES_IN=1h

# Email verification and password reset
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Local opt-in: set NODE_ENV=development and SIGNUP_EMAIL_MODE=console to print
# signup codes in the backend terminal instead of sending email. All code expiry,
# attempt limits, and resend cooldowns still apply. Console mode is rejected in
# production, test, and when NODE_ENV is unset. Default: email.
SIGNUP_EMAIL_MODE=email

# Blank provider settings log only local password-reset links. Signup requires
# configured email delivery unless the explicit local console mode above is used.
# Production should use a supported provider and verified sender.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
