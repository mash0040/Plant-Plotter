# Plant Plotter backend defaults
PORT=5001
NODE_ENV=development

# Comma-separate multiple allowed frontend origins if needed.
FRONTEND_URL=http://localhost:3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=garden_plotter

# Local MySQL usually does not need SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=

# Production Aiven MySQL must use verified TLS:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem

# Authentication
JWT_SECRET=replace_with_a_local_development_secret
JWT_EXPIRES_IN=1h

# Password reset email
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Leave email settings blank locally to log the reset link instead of sending email.
# Production should use a supported provider and verified sender.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
