{
  "name": "plantplotter-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "plantplotter",
    "plantplotter_backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npx concurrently \"npm run dev --workspace=plantplotter_backend\" \"npm run dev --workspace=plantplotter\"",
    "dev:backend": "npm run dev --workspace=plantplotter_backend",
    "dev:frontend": "npm run dev --workspace=plantplotter",
    "build": "npm run build --workspace=plantplotter",
    "start": "npm run start --workspace=plantplotter_backend"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  }
}
